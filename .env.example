# ===== Backend tiendaLujosa — copiar a .env (NO subir .env) =====
NODE_ENV=development
PORT=3001

# Base de datos PostgreSQL (mismo patrón de variables que SmartBucks)
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arkimenext
DB_USER=postgres
DB_PASSWORD=cambia_esta_clave
DB_SSL=false

# CORS: orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:3000

# Clave compartida con el frontend: se envía en la cabecera `x-app-token`.
# No es un JWT ni identifica usuarios: solo filtra clientes no autorizados.
# Debe coincidir con APP_ACCESS_TOKEN del frontend y NUNCA exponerse en el navegador.
APP_ACCESS_TOKEN=cambia_este_token_por_uno_largo_y_aleatorio

# Sesiones (ADR-0002)
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Valores iniciales de la tienda (los usa el seeder para store_settings)
DEFAULT_LOCALE=es
ACTIVE_LOCALES=es,en
STORE_CURRENCY=EUR

# Primer OWNER (solo para el seeder; no se sobrescribe un OWNER existente)
INITIAL_OWNER_EMAIL=
INITIAL_OWNER_PASSWORD=

# Imágenes (ADR-0004). 'local' solo en desarrollo; falla si NODE_ENV=production
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.uploads
MAX_IMAGE_SIZE_MB=5
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Correo (Mailpit en desarrollo: docker compose --profile mail up -d)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@tiendalujosa.local
